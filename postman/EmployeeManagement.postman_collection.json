{
  "info": {
    "name": "EmployeeManagement API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0",
    "description": "Bộ Postman đầy đủ theo backend.md. Dùng environment `baseUrl`, `accessToken`, `refreshToken`, `adminEmail`, `adminPassword`."
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5269" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van B\",\n  \"email\": \"employee.b@example.com\",\n  \"phoneNumber\": \"0912345678\",\n  \"password\": \"User1234\",\n  \"confirmPassword\": \"User1234\"\n}"
            },
            "url": "{{baseUrl}}/api/Auth/register"
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  var body = pm.response.json();",
                "  var data = body.data || {};",
                "  if (data.accessToken) pm.environment.set('accessToken', data.accessToken);",
                "  if (data.refreshToken) pm.environment.set('refreshToken', data.refreshToken);",
                "}"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/Auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/Auth/refresh-token"
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/Auth/logout"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Admin123@\",\n  \"newPassword\": \"Admin1234\",\n  \"confirmPassword\": \"Admin1234\"\n}"
            },
            "url": "{{baseUrl}}/api/Auth/change-password"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/api/Auth/forgot-password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"otpCode\": \"123456\",\n  \"newPassword\": \"Admin123@\",\n  \"confirmPassword\": \"Admin123@\"\n}"
            },
            "url": "{{baseUrl}}/api/Auth/reset-password"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/Users?page=1&pageSize=20" }
        },
        {
          "name": "Get By Id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/Users/1" }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Admin Moi\",\n  \"email\": \"admin.new@example.com\",\n  \"password\": \"Admin123@\",\n  \"phoneNumber\": \"0912345678\",\n  \"roleCode\": \"ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/api/Users"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Admin Updated\",\n  \"phoneNumber\": \"0912345678\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/Users/2"
          }
        },
        {
          "name": "Delete",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/Users/2" }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "Get List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/Employees?page=1&pageSize=10&search=&departmentId=&positionId=&status=&sortBy=fullName&sortDir=asc"
          }
        },
        {
          "name": "Get By Id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/Employees/1" }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van A\",\n  \"email\": \"nv.a@example.com\",\n  \"phoneNumber\": \"0912345678\",\n  \"dateOfBirth\": \"1998-01-15\",\n  \"gender\": \"Male\",\n  \"address\": \"Ha Noi\",\n  \"departmentId\": 1,\n  \"positionId\": 3,\n  \"hireDate\": \"2026-01-01\",\n  \"status\": \"Working\"\n}"
            },
            "url": "{{baseUrl}}/api/Employees"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van A Updated\",\n  \"email\": \"nv.a@example.com\",\n  \"phoneNumber\": \"0912345678\",\n  \"departmentId\": 1,\n  \"positionId\": 3,\n  \"hireDate\": \"2026-01-01\",\n  \"status\": \"Working\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/Employees/1"
          }
        },
        {
          "name": "Soft Delete",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/Employees/1" }
        },
        {
          "name": "Restore",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/Employees/1/restore" }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        { "name": "Get List", "request": { "method": "GET", "url": "{{baseUrl}}/api/Departments?page=1&pageSize=20" } },
        { "name": "Get By Id", "request": { "method": "GET", "url": "{{baseUrl}}/api/Departments/1" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"QA\",\n  \"name\": \"Quality Assurance\",\n  \"description\": \"QA team\",\n  \"isActive\": true\n}" },
            "url": "{{baseUrl}}/api/Departments"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"QA\",\n  \"name\": \"Quality Assurance\",\n  \"description\": \"Updated\",\n  \"isActive\": true\n}" },
            "url": "{{baseUrl}}/api/Departments/4"
          }
        },
        { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/Departments/4" } }
      ]
    },
    {
      "name": "Positions",
      "item": [
        { "name": "Get List", "request": { "method": "GET", "url": "{{baseUrl}}/api/Positions?page=1&pageSize=20" } },
        { "name": "Get By Id", "request": { "method": "GET", "url": "{{baseUrl}}/api/Positions/1" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"BA\",\n  \"name\": \"Business Analyst\",\n  \"description\": \"BA\",\n  \"level\": 3,\n  \"isActive\": true\n}" },
            "url": "{{baseUrl}}/api/Positions"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"BA\",\n  \"name\": \"Business Analyst\",\n  \"description\": \"Updated\",\n  \"level\": 3,\n  \"isActive\": true\n}" },
            "url": "{{baseUrl}}/api/Positions/5"
          }
        },
        { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/Positions/5" } }
      ]
    },
    {
      "name": "Profile",
      "item": [
        { "name": "Get My Profile", "request": { "method": "GET", "url": "{{baseUrl}}/api/Profile" } },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van A\",\n  \"phoneNumber\": \"0912345678\",\n  \"dateOfBirth\": \"1998-01-15\",\n  \"gender\": \"Male\",\n  \"address\": \"Ha Noi\"\n}"
            },
            "url": "{{baseUrl}}/api/Profile"
          }
        },
        {
          "name": "Upload Avatar",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": "{{baseUrl}}/api/Profile/avatar"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        { "name": "Get Stats", "request": { "method": "GET", "url": "{{baseUrl}}/api/Dashboard" } }
      ]
    },
    {
      "name": "AuditLogs",
      "item": [
        { "name": "Get List", "request": { "method": "GET", "url": "{{baseUrl}}/api/AuditLogs?page=1&pageSize=20" } }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    }
  ]
}
